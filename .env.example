# 🧠 Multi-Persona Agent Studio - Environment Configuration Template

# 1. Groq API Key (Optional)
# If provided, the system runs in high-performance cloud mode using the 'llama3-70b-8192' model on Groq.
# If omitted/left blank, the system falls back to Local Mode using 'llama3' running on a local Ollama instance.
GROQ_API_KEY=

# 2. LangSmith Tracing (Optional)
# Configure these variables to log and trace agent execution steps, routing decisions, and LLM prompts on LangSmith.
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-persona-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
